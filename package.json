{
  "name": "@k9o/cli",
  "version": "1.5.0",
  "description": "k9o — the Kilimanjaro CLI. Operator sign-in or service token, then project, migration, function, policy, audit, org, me, storage, vault-secret, ext-admin and config commands. Distributed via npm + Homebrew + standalone binaries.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "k9o": "dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ext-admin-contract": "./src/ext-admin-contract.ts",
    "./command-manifest.json": "./command-manifest.json"
  },
  "files": [
    "dist",
    "src",
    "command-manifest.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "Apache-2.0",
  "homepage": "https://kilimanjaro.dev",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/k9o-platform/k9o-cli",
    "directory": "packages/cli"
  },
  "scripts": {
    "test": "HOME=$(mktemp -d) bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run scripts/build.ts",
    "manifest": "bun run scripts/emit-command-manifest.ts"
  },
  "devDependencies": {
    "@k9o/core": "*",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
